rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default-Deny Everything
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Security Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isVerified() && request.auth.token.email == 'mdabusayedm92@gmail.com';
    }

    // Admin Gate: Super Admin email OR explicitly promoted admin marker doc
    function isAdmin() {
      return isSuperAdmin() || (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // 3. Entity Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'fullName', 'email', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'fullName', 'email', 'phone', 'division', 'district', 'upazila', 'address', 'role', 'createdAt', 'updatedAt'])
        && data.uid is string && isValidId(data.uid)
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 180
        && data.role in ['customer', 'admin']
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 20))
        && (!('division' in data) || (data.division is string && data.division.size() <= 60))
        && (!('district' in data) || (data.district is string && data.district.size() <= 60))
        && (!('upazila' in data) || (data.upazila is string && data.upazila.size() <= 80))
        && (!('address' in data) || (data.address is string && data.address.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminMarker(data) {
      return data.keys().hasAll(['uid', 'email', 'promotedBy', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'promotedBy', 'updatedAt'])
        && data.uid is string && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 180
        && data.promotedBy is string && isValidId(data.promotedBy)
        && data.updatedAt is timestamp;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'category', 'price', 'stock', 'imageUrl', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'category', 'price', 'comparePrice', 'unit', 'stock', 'deliveryCharge', 'dhakaDeliveryCharge', 'outsideDhakaDeliveryCharge', 'description', 'imageUrl', 'additionalImages', 'isActive', 'isFeatured', 'createdAt', 'updatedAt'])
        && data.id is string && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.category in ['electronics', 'fashion', 'home', 'beauty', 'kids', 'other']
        && data.price is number && data.price >= 0 && data.price <= 10000000
        && (!('comparePrice' in data) || (data.comparePrice is number && data.comparePrice >= 0 && data.comparePrice <= 10000000))
        && (!('unit' in data) || (data.unit is string && data.unit.size() <= 50))
        && data.stock is number && data.stock >= 0 && data.stock <= 1000000
        && (!('deliveryCharge' in data) || (data.deliveryCharge is number && data.deliveryCharge >= 0 && data.deliveryCharge <= 10000))
        && (!('dhakaDeliveryCharge' in data) || (data.dhakaDeliveryCharge is number && data.dhakaDeliveryCharge >= 0 && data.dhakaDeliveryCharge <= 10000))
        && (!('outsideDhakaDeliveryCharge' in data) || (data.outsideDhakaDeliveryCharge is number && data.outsideDhakaDeliveryCharge >= 0 && data.outsideDhakaDeliveryCharge <= 10000))
        && (!('description' in data) || (data.description is string && data.description.size() <= 2000))
        && data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 1000
        && (!('additionalImages' in data) || (data.additionalImages is list && data.additionalImages.size() <= 8))
        && data.isActive is bool
        && (!('isFeatured' in data) || data.isFeatured is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['id', 'productId', 'productName', 'userId', 'authorName', 'rating', 'comment', 'createdAt'])
        && data.keys().hasOnly(['id', 'productId', 'productName', 'userId', 'authorName', 'rating', 'comment', 'createdAt'])
        && data.id is string && isValidId(data.id)
        && data.productId is string && isValidId(data.productId)
        && data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 200
        && data.userId is string && isValidId(data.userId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() >= 2 && data.comment.size() <= 800
        && data.createdAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['orderId', 'userId', 'customerName', 'customerPhone', 'division', 'district', 'upazila', 'address', 'paymentMethod', 'items', 'subtotal', 'deliveryCharge', 'total', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['orderId', 'userId', 'isGuest', 'customerName', 'customerPhone', 'customerEmail', 'division', 'district', 'upazila', 'address', 'orderNote', 'paymentMethod', 'bkashSender', 'bkashTrxId', 'items', 'subtotal', 'deliveryCharge', 'total', 'status', 'statusNote', 'createdAt', 'updatedAt'])
        && data.orderId is string && isValidId(data.orderId)
        && data.userId is string && isValidId(data.userId)
        && (!('isGuest' in data) || data.isGuest is bool)
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120
        && data.customerPhone is string && data.customerPhone.size() >= 11 && data.customerPhone.size() <= 20
        && (!('customerEmail' in data) || (data.customerEmail is string && data.customerEmail.size() <= 180))
        && data.division is string && data.division.size() >= 1 && data.division.size() <= 60
        && data.district is string && data.district.size() >= 1 && data.district.size() <= 60
        && data.upazila is string && data.upazila.size() >= 1 && data.upazila.size() <= 80
        && data.address is string && data.address.size() >= 3 && data.address.size() <= 300
        && (!('orderNote' in data) || (data.orderNote is string && data.orderNote.size() <= 400))
        && data.paymentMethod in ['cod', 'bkash']
        && (!('bkashSender' in data) || (data.bkashSender is string && data.bkashSender.size() <= 20))
        && (!('bkashTrxId' in data) || (data.bkashTrxId is string && data.bkashTrxId.size() <= 40))
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 50 && data.items[0] is map
        && data.subtotal is number && data.subtotal >= 0 && data.subtotal <= 10000000
        && data.deliveryCharge is number && data.deliveryCharge >= 0 && data.deliveryCharge <= 50000
        && data.total is number && data.total >= 0 && data.total <= 10000000
        && data.status in ['pending', 'confirmed', 'packed', 'shipped', 'delivered', 'cancelled']
        && (!('statusNote' in data) || (data.statusNote is string && data.statusNote.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrderTracking(data) {
      return data.keys().hasAll(['orderId', 'userId', 'phoneLast4', 'status', 'total', 'district', 'updatedAt'])
        && data.keys().hasOnly(['orderId', 'userId', 'phoneLast4', 'status', 'statusNote', 'total', 'district', 'updatedAt'])
        && data.orderId is string && isValidId(data.orderId)
        && data.userId is string && isValidId(data.userId)
        && data.phoneLast4 is string && data.phoneLast4.size() == 4
        && data.status in ['pending', 'confirmed', 'packed', 'shipped', 'delivered', 'cancelled']
        && (!('statusNote' in data) || (data.statusNote is string && data.statusNote.size() <= 300))
        && data.total is number && data.total >= 0 && data.total <= 10000000
        && data.district is string && data.district.size() >= 1 && data.district.size() <= 60
        && data.updatedAt is timestamp;
    }

    function isValidShopSetting(data) {
      return data.keys().hasAll(['storeName', 'tagline', 'supportPhone', 'bkashNumber', 'dhakaDelivery', 'outsideDhakaDelivery', 'updatedAt'])
        && data.keys().hasOnly(['storeName', 'tagline', 'supportPhone', 'bkashNumber', 'dhakaDelivery', 'outsideDhakaDelivery', 'promoBanner', 'updatedAt'])
        && data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 100
        && data.tagline is string && data.tagline.size() >= 1 && data.tagline.size() <= 160
        && data.supportPhone is string && data.supportPhone.size() >= 6 && data.supportPhone.size() <= 25
        && data.bkashNumber is string && data.bkashNumber.size() >= 11 && data.bkashNumber.size() <= 20
        && data.dhakaDelivery is number && data.dhakaDelivery >= 0 && data.dhakaDelivery <= 2000
        && data.outsideDhakaDelivery is number && data.outsideDhakaDelivery >= 0 && data.outsideDhakaDelivery <= 2000
        && (!('promoBanner' in data) || (
          data.promoBanner is map
          && data.promoBanner.keys().hasOnly(['isActive', 'tag', 'headline', 'subtitle', 'ctaText', 'targetType', 'targetValue'])
          && data.promoBanner.isActive is bool
          && data.promoBanner.tag is string && data.promoBanner.tag.size() <= 60
          && data.promoBanner.headline is string && data.promoBanner.headline.size() <= 160
          && data.promoBanner.subtitle is string && data.promoBanner.subtitle.size() <= 240
          && data.promoBanner.ctaText is string && data.promoBanner.ctaText.size() <= 40
          && data.promoBanner.targetType in ['all', 'category', 'product']
          && data.promoBanner.targetValue is string && data.promoBanner.targetValue.size() <= 128
        ))
        && data.updatedAt is timestamp;
    }

    // 4. Collection Rules
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUser(incoming())
        && incoming().uid == request.auth.uid
        && (incoming().role == 'customer' || isSuperAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(userId)
        && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && (
            incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'phone', 'division', 'district', 'upazila', 'address', 'updatedAt'])
          )) ||
          (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().email == existing().email
            && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'phone', 'division', 'district', 'upazila', 'address', 'updatedAt'])
          )
        );
      allow delete: if isSuperAdmin() && isValidId(userId);
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && isValidId(userId)
        && isValidAdminMarker(incoming())
        && incoming().uid == userId
        && incoming().promotedBy == request.auth.uid
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(userId);
    }

    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if isAdmin()
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().id == productId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(productId);
    }

    match /productReviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if true;
      allow create: if isSignedIn()
        && isValidId(reviewId)
        && isValidReview(incoming())
        && incoming().id == reviewId
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow delete: if isValidId(reviewId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
    }

    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().orderId == orderId
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().orderId == existing().orderId
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'statusNote', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(orderId);
    }

    match /orderTracking/{orderId} {
      allow get: if isValidId(orderId);
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(orderId)
        && isValidOrderTracking(incoming())
        && incoming().orderId == orderId
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/orders/$(orderId));
      allow update: if isAdmin()
        && isValidId(orderId)
        && isValidOrderTracking(incoming())
        && incoming().orderId == existing().orderId
        && incoming().userId == existing().userId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'statusNote', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(orderId);
    }

    match /shopSettings/{settingId} {
      allow get: if isValidId(settingId) && settingId == 'public';
      allow list: if false;
      allow create, update: if isAdmin()
        && isValidId(settingId)
        && settingId == 'public'
        && isValidShopSetting(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }
  }
}
